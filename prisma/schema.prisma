// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  MOBILE_WALLET
}

enum Role {
  AGENT
  CLIENT
}

enum Status {
  ACTIVE
  INACTIVE
}

model User {
  id String @id @default(cuid())

  name                String
  email               String        @unique
  role                Role          @default(CLIENT)
  emailVerified       Boolean
  onboardingCompleted Boolean       @default(false)
  image               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  sessions            Session[]
  accounts            Account[]
  organization        Organization?

  @@map("user")
}

model Organization {
  id          String       @id @default(cuid())
  name        String       @unique
  logoUrl     String
  resNos      Int          @default(1)
  description String
  ownerId     String       @unique
  owner       User         @relation(fields: [ownerId], references: [id])
  restaurants Restaurant[]

  @@map("organization")
}

model Restaurant {
  id             String       @id @default(cuid())
  name           String       @unique
  logoUrl        String?
  phone          String
  email          String
  staffNos       Int          @default(1)
  status         Status       @default(ACTIVE)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  location       Location?
  order          Order[]
  products       Product[]

  @@index([organizationId])
  @@map("restaurant")
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Location {
  id           String     @id @default(cuid())
  state        String
  address      String
  city         String
  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@map("location")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Product {
  id            String      @id @default(cuid())
  name          String
  logoUrl       String
  price         Int
  description   String
  stockQuantity Int
  inStock       Boolean     @default(true)
  restaurantId  String
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItem     OrderItem[]

  @@index([restaurantId])
  @@map("product")
}

model Order {
  id          String @id @default(uuid())
  orderNumber Int    @unique @default(autoincrement())

  // Fulfillment & Timing Data
  orderType           OrderType
  orderStatus         OrderStatus @default(PENDING)
  scheduledFor        DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  specialInstructions String?     @db.Text

  // Customer & Contact Information
  customerName    String
  customerPhone   String
  deliveryAddress Address? @relation(fields: [addressId], references: [id])
  addressId       String?
  tableNumber     String? // Used for Dine-In orders

  // Financial Data
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @db.Decimal(10, 2)
  deliveryFee   Decimal       @default(0.00) @db.Decimal(10, 2)
  tip           Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)

  // Relations
  items        OrderItem[]
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])

  // Indexes for query optimization
  @@index([restaurantId, orderStatus])
  @@index([restaurantId, createdAt])
}

model OrderItemModification {
  id          String    @id @default(uuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  name        String // e.g., "Extra Spicy", "No Onions"
  priceCharge Decimal   @default(0.00) @db.Decimal(10, 2) // If adding the modification costs extra

  @@index([orderItemId])
}

model Address {
  id                   String  @id @default(uuid())
  streetAddress        String
  apartmentSuiteNumber String?
  city                 String
  postalCode           String
  deliveryInstructions String? @db.Text
  orders               Order[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity               Int
  unitPrice              Decimal                 @db.Decimal(10, 2) // Snapshotted price at checkout
  totalPrice             Decimal                 @db.Decimal(10, 2)
  orderItemModifications OrderItemModification[]
}
